{
  "name": "@acme/api",
  "type": "module",
  "private": true,
  "exports": {
    "./auth": "./src/lib/auth.ts",
    "./trpc": "./src/trpc/index.ts"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "check": "biome check --write src",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "secret:generate": "openssl rand -base64 48",
    "db:start": "dotenv -- bash -c 'docker run --name $APP_NAME-db -e POSTGRES_PASSWORD=$POSTGRES_PASSWORD -e POSTGRES_USER=$POSTGRES_USER -e POSTGRES_DB=$POSTGRES_DB -p $POSTGRES_PORT:5432 -d postgres:latest'",
    "db:stop": "dotenv -- bash -c 'docker stop $APP_NAME-db && docker rm $APP_NAME-db'",
    "db:push": "dotenv -- drizzle-kit push",
    "db:migrate": "dotenv -- tsx migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "dotenv -- drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/prometheus": "^1.0.1",
    "@hono/swagger-ui": "^0.6.0",
    "@hono/trpc-server": "^0.3.4",
    "@trpc/server": "11.0.0-rc.819",
    "await-to-js": "^3.0.0",
    "better-auth": "^1.1.21",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
