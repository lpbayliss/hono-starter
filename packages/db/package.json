{
	"name": "@acme/db",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"description": "",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"db:start": "dotenv -- bash -c 'docker run --name $APP_NAME-db -e POSTGRES_PASSWORD=$POSTGRES_PASSWORD -e POSTGRES_USER=$POSTGRES_USER -e POSTGRES_DB=$POSTGRES_DB -p $POSTGRES_PORT:5432 -d postgres:latest'",
		"db:stop": "dotenv -- bash -c 'docker stop $APP_NAME-db && docker rm $APP_NAME-db'",
		"db:push": "dotenv -- drizzle-kit push",
		"db:migrate": "dotenv -- tsx migrate.ts",
		"db:generate": "drizzle-kit generate",
		"db:studio": "dotenv -- drizzle-kit studio",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@acme/env": "workspace:*",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.11.11",
		"dotenv-cli": "^8.0.0",
		"drizzle-kit": "^0.30.5",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.40.0",
		"pg": "^8.13.3",
		"postgres": "^3.4.5",
		"zod": "^3.24.2"
	}
}
